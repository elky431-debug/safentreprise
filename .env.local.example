# Copiez ce fichier vers .env.local et renseignez vos clés
# .env.local est ignoré par git : aucune clé ne doit être committée.

# --- Supabase ---
# Accessibles au navigateur (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publishable

# Réservée au serveur : contourne la Row Level Security, ne jamais l'exposer
SUPABASE_SECRET_KEY=votre-cle-secrete

# Connexion Postgres directe, utilisée uniquement par « npm run db:apply »
# Supabase > Project Settings > Database > Connection string > URI (mode Session)
DATABASE_URL=postgresql://postgres.votre-projet:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# --- Application ---
# URL publique de l'app (liens de tracking dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (envoi des emails de simulation, serveur uniquement) ---
RESEND_API_KEY=re_xxxxxxxx
# Adresse technique d'expédition. Pour les tests Resend :
#   SIMULATION_FROM_EMAIL=onboarding@resend.dev
# En production : une adresse de votre domaine vérifié chez Resend.
SIMULATION_FROM_EMAIL=onboarding@resend.dev

# --- Raccordement d'un client Microsoft 365 ---
# Adresse de retour du consentement administrateur. Elle doit correspondre AU
# CARACTÈRE PRÈS à l'URI déclarée dans Azure (Entra ID → votre app →
# Authentification → Web). HTTPS, pas de barre oblique finale, minuscules.
# Contrôler : POST /api/microsoft/worker?verifier=1
MS_REDIRECT_URI=https://safentreprise.com/api/microsoft/consentement

# --- Demandes de démonstration (formulaire /demo) ---
# Où arrive la notification à chaque demande enregistrée.
DEMO_NOTIFICATION_EMAIL=elky431@gmail.com
# Expéditeur des deux emails (notification et confirmation).
# ⚠ DOIT ÊTRE UNE ADRESSE @safentreprise.com, vérifiée chez Resend. Toute autre
#   adresse est refusée par le code : un envoi depuis un domaine non vérifié
#   part en indésirable, et un envoi « de » gmail.com est rejeté par DMARC.
#   À défaut, VEILLE_FROM_EMAIL est utilisée.
DEMO_FROM_EMAIL=contact@safentreprise.com

# --- Veille (alerte par mail quand une vue de contrôle n'est plus vide) ---
# ⚠ onboarding@resend.dev ne peut écrire QU'À l'adresse du compte Resend.
#   Pour alerter une autre adresse, il faut un domaine vérifié chez Resend.
#   Contrôler ce que Resend accepte vraiment : POST /api/veille?verifier=1
VEILLE_FROM_EMAIL=veille@safentreprise.com
VEILLE_DESTINATAIRE=contact@safentreprise.com

# --- Alerte de fraude au dirigeant (risque ÉLEVÉ uniquement) ---
# Expéditeur des alertes envoyées au dirigeant du client.
# ⚠ DOIT ÊTRE UNE ADRESSE @safentreprise.com vérifiée chez Resend — même garde
#   que pour les demandes de démo. À défaut : VEILLE_FROM_EMAIL, puis
#   DEMO_FROM_EMAIL. Si aucune ne convient, AUCUNE ALERTE NE PART, et le
#   contrôle « expéditeur des alertes » de ?verifier=1 passe au rouge.
ALERTE_FROM_EMAIL=alertes@safentreprise.com
#
# Destinataire de l'ESSAI en blanc (POST /api/microsoft/worker?essai-alerte=1).
# ⚠ JAMAIS L'ADRESSE D'UN CLIENT : l'essai envoie un faux « tentative de fraude
#   détectée ». À défaut : DEMO_NOTIFICATION_EMAIL.
ALERTE_ESSAI_EMAIL=elky431@gmail.com
#
# Fenêtre anti-rafale, en minutes. Une société reçoit au plus un email par
# fenêtre ; les alertes survenues pendant celle-ci partent ensuite groupées
# dans un résumé. Aucune n'est perdue. Par défaut : 60.
# ALERTE_FENETRE_MINUTES=60

# --- SMS Partner (envoi des SMS de simulation, serveur uniquement) ---
# Clé API : espace client SMS Partner → API
SMSPARTNER_API_KEY=votre-cle-api
# Expéditeur alphanumérique validé (3–11 caractères, sans caractères spéciaux)
SMSPARTNER_SENDER=VotreMarque

# --- Microsoft Graph (analyse des boîtes Microsoft 365) ---
# Application Azure « Safentreprise Guard », multi-tenant,
# permission Mail.ReadWrite en autorisation d'APPLICATION.
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=valeur-du-secret-client
# Boîte à surveiller pour les essais
MS_MAILBOX=admin@votre-tenant.onmicrosoft.com
# URL publique du webhook. Microsoft l'appelle AVANT de créer l'abonnement :
# elle doit déjà être déployée et répondre à la poignée de main.
# Essai   : https://<branche>--<site>.netlify.app/api/microsoft/webhook
# Prod    : https://safentreprise.com/api/microsoft/webhook
GRAPH_NOTIFICATION_URL=https://safentreprise.com/api/microsoft/webhook
