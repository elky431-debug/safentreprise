# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Route d'aperçu de la direction artistique — jamais versionnée.
#
# `src/app/apercu-*/page.tsx` rend le tableau de bord avec un jeu de
# données entièrement fabriqué, sans session ni base, pour la relecture
# visuelle de chaque étape de docs/DIRECTION-ARTISTIQUE.md. Elle n'a rien à
# faire dans le dépôt : elle deviendrait une route publique de l'application,
# et elle divergerait du vrai écran dès la première modification. La source
# est conservée hors du dépôt et recopiée ici au besoin.
src/app/apercu-*/
